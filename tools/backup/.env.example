# Copy this file to ".env" (same folder) and fill it in. Never share or upload the .env file.
SUPABASE_URL=https://fbrnxuargsilbyyjrjop.supabase.co
# Supabase dashboard -> Project Settings -> API -> "service_role" key (the secret one, NOT the anon key)
SUPABASE_SERVICE_ROLE_KEY=paste-it-here
# Where the backups go on this computer:
BACKUP_DIR=~/HomeschoolBackups
# How many dated data backups to keep (older ones are deleted):
KEEP_BACKUPS=12

# Maximum response-body downloads per backup run in MiB (not the total account quota).
# A partial run fails visibly and does not prune older backups. Start at 100; change only after checking Usage.
MAX_BACKUP_DOWNLOAD_MB=100
